{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/ai-quiz", "destination": "/ai-quiz/index.html" }
  ],
  "headers": [
    {
      "source": "/ai-quiz/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
